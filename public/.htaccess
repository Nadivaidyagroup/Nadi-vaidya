# nadivaidya.in — क्लीनिक वेबसाइट
# पुराने Gurukul / Pharmacy पतों को नई वेबसाइटों पर स्थायी (301) redirect,
# ताकि Google पुराने पेजों की रैंकिंग नई साइटों को दे दे।

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # हमेशा https और बिना www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://nadivaidya.in/$1 [R=301,L]

  # ===== Gurukul (nadivaidya.com) =====
  RewriteRule ^free-workshop(/.*)?$ https://nadivaidya.com/pages/nadi-pariksha-course [R=301,L]
  RewriteRule ^workshop-schedule/?$ https://nadivaidya.com/pages/nadi-pariksha-course#karyakram [R=301,L,NE]
  RewriteRule ^nadi-pariksha-form/?$ https://nadivaidya.com/pages/nadi-pariksha-course [R=301,L]
  RewriteRule ^gallery(/.*)?$ https://nadivaidya.com/pages/gallery [R=301,L]
  RewriteRule ^team/?$ https://nadivaidya.com/pages/about-us#team [R=301,L,NE]
  # (/blog अब क्लीनिक का अपना स्वास्थ्य ब्लॉग है — केवल पुराना /news-blogs Gurukul पर)
  RewriteRule ^news-blogs(/.*)?$ https://nadivaidya.com/blogs/news-blogs [R=301,L]

  # ===== Pharmacy (nadivaidyapharmacy.com) =====
  RewriteRule ^(shop|product|products|cart|checkout)(/.*)?$ https://nadivaidyapharmacy.com/ [R=301,L]

  # ===== React app =====
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# setup/लॉग फ़ाइलें कोई बाहर से न खोल सके
<FilesMatch "^(createtable2\.php|error_log)$">
  Require all denied
</FilesMatch>

# Security headers + caching
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|woff2?|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
